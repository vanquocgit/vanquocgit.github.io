---
export interface Props {
  id?: string;
  title?: string;
}

const { id = '', title = 'Video Vlog' } = Astro.props;
const cleanId = id.trim();
---

{cleanId && (
  <div
    class="yt-embed not-prose my-6 overflow-hidden rounded-2xl border border-line bg-subtle"
    data-youtube-id={cleanId}
    data-youtube-title={title}
  >
    <button
      type="button"
      class="yt-trigger group relative block aspect-video w-full cursor-pointer overflow-hidden text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
      aria-label={`Phát video: ${title}`}
    >
      <img
        src={`https://i.ytimg.com/vi/${cleanId}/hqdefault.jpg`}
        alt={`Ảnh thu nhỏ video: ${title}`}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      />
      <div class="absolute inset-0 flex flex-col items-center justify-center bg-ink/25 transition-colors group-hover:bg-ink/35">
        <span class="flex h-16 w-16 items-center justify-center rounded-full border border-paper/40 bg-ink/90 text-paper transition-transform duration-200 group-hover:scale-105">
          <svg class="ml-1 h-7 w-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
        <span class="mt-3 rounded-full bg-ink/80 px-3.5 py-1 text-xs font-medium text-paper">
          Bấm để phát video Vlog
        </span>
      </div>
    </button>
  </div>
)}

<script>
  document.querySelectorAll('.yt-embed').forEach((container) => {
    const button = container.querySelector('.yt-trigger');
    if (!button) return;
    button.addEventListener('click', () => {
      const id = container.getAttribute('data-youtube-id');
      const title = container.getAttribute('data-youtube-title') || 'YouTube Video';
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'aspect-video w-full border-0';
      container.innerHTML = '';
      container.appendChild(iframe);
    });
  });
</script>
